# Artefatos de pesquisa (não versionados por padrão)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/outputs/*
!data/outputs/.gitkeep

# Dicionários e dados de configuração são versionados; ignore só temporários
data/dictionaries/*.tmp

# Artigos baixados (direitos autorais) — fichamentos são versionados
references/artigos/*
!references/artigos/.gitkeep

# Ambiente local
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
.ipynb_checkpoints/

# Saídas de build/exportação
docs/**/_build/
*.tmp.docx
~$*

# Sistema operacional
.DS_Store
Thumbs.db
